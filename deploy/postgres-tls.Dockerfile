# Local TLS-serving PostgreSQL for docker-compose.prod.yml.
#
# The application's production code path validates the database server
# certificate against a configured trust anchor and never falls back to
# accepting an unverified one (ZT-012 — src/config/database-ssl.ts). To exercise
# that real path locally, the local Postgres has to actually serve TLS.
#
# The certificate baked in here is generated by `deploy/generate-local-tls.sh`
# and is disposable: it secures one local container and is trusted nowhere.
# A managed production database provides its own certificate and CA — this
# image is never part of a production deployment.
#
# Build context is the `deploy/` directory:
#   docker build -f deploy/postgres-tls.Dockerfile -t ziyarati-postgres-tls deploy
FROM pgvector/pgvector:pg18

COPY tls/server.crt /etc/postgresql/tls/server.crt
COPY tls/server.key /etc/postgresql/tls/server.key

# Postgres refuses to start if the private key is group/world readable, and it
# must be owned by the runtime user.
RUN chown -R postgres:postgres /etc/postgresql/tls \
 && chmod 600 /etc/postgresql/tls/server.key \
 && chmod 644 /etc/postgresql/tls/server.crt
