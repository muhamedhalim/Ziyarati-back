###############################################################################
# Ziyarati backend — environment variable reference
#
# This file is the AUTHORITATIVE list of every environment variable this
# codebase reads. It is derived from, and must stay in sync with:
#   * src/config/env.validation.ts  — the Joi schema + production fail-fasts
#   * every `process.env.*` / `configService.get()` call site under src/
#
# TWO SEPARATE ECS SERVICES (API and worker, AWS) read this codebase, from two different
# entrypoints, and this file is split to match them exactly:
#
#   PART 1 — API SERVER    `node dist/src/main.js`    (HTTP + WebSocket)
#   PART 2 — WORKER SERVER `node dist/src/worker.js`   (BullMQ job consumer)
#
# Each PART has two subsections:
#   SHARED   variables actually read by (or required to boot) BOTH services.
#            Set these on BOTH the API ECS service and the Worker ECS
#            service, with the SAME value. Fully documented once, in PART 1 —
#            PART 2's SHARED subsection is a checklist that points back here.
#   -ONLY    variables that service alone reads. Do NOT set a worker-only
#            variable on the API service, or vice versa — it is simply unused
#            there, and setting it creates the false impression that it does
#            something on that service.
#
# A variable counts as SHARED here if EITHER: (a) real code in both processes
# reads its value, OR (b) `env.validation.ts`'s Joi schema makes it
# unconditionally `.required()` — the SAME schema runs in both processes'
# `ConfigModule.forRoot()`, so a missing required variable refuses to boot
# EVERY process, not just the one that later uses the value. A few variables
# are used by only one service yet are still validated by that same shared
# schema at PRODUCTION boot-time (e.g. AUTH_REGISTER_OWNER_ENDPOINT_CEILING);
# those are called out with an explicit "must ALSO be set on the other
# service in production, or it will refuse to boot" note where it applies.
#
# HOW TO READ THIS FILE
#   [REQUIRED]        the process refuses to boot without it, in EVERY env.
#   [PROD-REQUIRED]   optional in dev/test; production REFUSES TO BOOT without
#                     it (an explicit fail-fast in env.validation.ts).
#   [OPTIONAL]        safe to leave unset — the shown value is the code's own
#                     default, so setting it to that value changes nothing.
#   [DEV-ONLY]        must NOT be set (or must be `false`) in production.
#
# Values below are PLACEHOLDERS or real defaults. No secret in this file is a
# working credential. Never commit a filled-in copy — commit only this one.
###############################################################################


###############################################################################
###############################################################################
##  PART 1 — API SERVER  (`node dist/src/main.js`)
##  These variables must be set on the API ECS service.
###############################################################################
###############################################################################


###############################################################################
# ══ SHARED ══  Also required on the WORKER ECS service (PART 2 § SHARED)
###############################################################################

# ─────────────────────────────────────────────────────────────────────────
# SHARED — APP
# ─────────────────────────────────────────────────────────────────────────

# [OPTIONAL] development | production | test. Default: development.
# Production MUST be `production` — it is the switch that turns on Secure
# cookies, HSTS, the TypeORM-synchronize ban, DB certificate validation and
# every production fail-fast in env.validation.ts. Read by both process roots
# at boot and throughout (e.g. every `NODE_ENV === 'production'` branch).
NODE_ENV=production

# [OPTIONAL] Public base URL used to build absolute links inside outbound
# emails and integration OAuth redirects. Falls back to the first
# FRONTEND_ORIGIN entry when unset. Set it in production — an email link is
# useless if it points at a development host. Read by EmailModule and
# IntegrationPlatformModule, both imported by the API AND the worker (the
# worker composes/sends emails and refreshes integration OAuth tokens).
APP_URL=https://api.example.com

# [OPTIONAL, non-production only] Secondary fallback for APP_URL, read only by
# the built-in test OAuth provider (INTEGRATION_OAUTH_TEST_PROVIDER), inside
# IntegrationPlatformModule (shared). Leave unset in production.
#API_BASE_URL=

# [OPTIONAL] Platform-wide default locale, the last fallback in the outbound
# notification/email locale-resolution chain (NotificationsModule, shared).
# One of: en | ar. Default: en.
DEFAULT_LOCALE=en


# ─────────────────────────────────────────────────────────────────────────
# SHARED — DATABASE
# ─────────────────────────────────────────────────────────────────────────

# [REQUIRED] PostgreSQL connection string. The pgvector extension must be
# available (the AiPgVector migration runs CREATE EXTENSION). Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Read by the shared `typeOrmFactory()` (src/config/typeorm.config.ts), called
# by BOTH `AppModule` (role 'api') and `WorkerModule` (role 'worker').
DATABASE_URL=postgresql://user:CHANGE_ME@db.example.com:5432/ziyarati

# [PROD-REQUIRED — exactly one of the two, never both]
# Production validates the database server certificate against this trust
# anchor and NEVER falls back to accepting any certificate. Outside production
# TLS is off entirely and both are ignored. Checked by the shared schema at
# boot in BOTH processes, and used by the shared `typeOrmFactory()`.
#   DB_SSL_CA      — filesystem path to a PEM file mounted into the container.
#   DB_SSL_CA_CERT — the PEM itself, inline (for platforms with no file mounts).
# Setting BOTH is a boot error (ambiguous which one is in effect).
DB_SSL_CA=/etc/ssl/certs/db-ca.crt
#DB_SSL_CA_CERT=-----BEGIN CERTIFICATE-----\nCHANGE_ME\n-----END CERTIFICATE-----

# [OPTIONAL] true | false, default false. Schema auto-sync. `true` together
# with NODE_ENV=production is a HARD BOOT ERROR — production schema is owned by
# migrations only. [DEV-ONLY]
#
# WHAT `true` ACTUALLY DOES, measured (P0.2, on a disposable database built by
# running the full migration chain from empty): one boot issues 178 DROP INDEX,
# 120 DROP CONSTRAINT, 23 DROP COLUMN and 28 ALTER COLUMN … DROP NOT NULL. Net
# permanent loss: 32 integrity guards (21 UNIQUE indexes, 10 CHECK constraints,
# 1 UNIQUE constraint) plus the DATA in 23 columns — including
# `clinical_entry_revisions.changed_byId`, a clinical audit trail, and the
# `deleted_at` columns, whose re-creation UN-DELETES every soft-deleted row.
# TypeORM drops anything entity metadata does not describe. Use it only against
# a throwaway database you are willing to lose. Read by the shared
# `typeOrmFactory()` — leave `false` on BOTH services.
TYPEORM_SYNCHRONIZE=false

# [OPTIONAL] false, or the exact database name from DATABASE_URL — never
# "true" (P0.6: rejected at boot, on both processes). Waives the P0.3 guard
# that refuses to boot when TYPEORM_SYNCHRONIZE=true and the target database
# has a non-empty `migrations` table (i.e. it was provisioned by the migration
# chain and is therefore persistent — staging, QA, a restored backup, a shared
# team box). Scoped (P0.6) to the ONE database it names: the value must equal
# that database's own name AND DATABASE_URL's host must be loopback
# (localhost/127.0.0.1/::1) — a bare boolean used to waive this guard for
# WHATEVER database happened to be configured, so a .env copied elsewhere, or
# repointed at a different database, silently inherited the waiver too. Only
# reachable when TYPEORM_SYNCHRONIZE is already true, which production
# refuses outright, so this cannot widen production behaviour. [DEV-ONLY]
#   e.g. if DATABASE_URL is postgres://user:pass@127.0.0.1:5433/ziyarati :
#   TYPEORM_SYNCHRONIZE_ALLOW_MIGRATED_DB=ziyarati
TYPEORM_SYNCHRONIZE_ALLOW_MIGRATED_DB=false

# [OPTIONAL] true | false, default false. Raw SQL logging INCLUDING parameter
# values. `true` together with NODE_ENV=production is a HARD BOOT ERROR (it
# writes tenant data and secrets to stdout). [DEV-ONLY]. Read by the shared
# `typeOrmFactory()`.
#
# Under NODE_ENV=test it is additionally forced OFF unless
# TYPEORM_LOGGING_IN_TEST=true.
TYPEORM_LOGGING=false
#TYPEORM_LOGGING_IN_TEST=false

# [OPTIONAL] Connection pool sizing. Shared default for both process roots; the
# API_/WORKER_-prefixed role-specific overrides below (in each PART's -ONLY
# section) take precedence over these when set.
#
# ── HOW THESE NUMBERS WERE DERIVED (measured, not guessed) ───────────────────
# k6 load run, single API process, arrival rates 5 -> 160 iterations/s, with
# `pg_stat_activity` sampled throughout. Peak demand for ONE API process:
#
#     concurrently ACTIVE connections ....... 5   (of a pool of 10)
#     idle in transaction ................... 4
#
# The process saturates one CPU core at ~90-100 it/s, so it physically cannot
# generate more database demand than that. 15 therefore already carries ~3x
# headroom over the measured peak, and RAISING IT IS NOT INDICATED — a booking
# used to need its transaction's connection PLUS a free one (see
# `AppointmentsService.create`), which made the pool look like the constraint;
# it was a self-deadlock, and it is fixed in code rather than by buying
# connections.
#
# ── BUDGET AGAINST max_connections ──────────────────────────────────────────
# Postgres ships (and this deployment runs) max_connections=100 with
# superuser_reserved_connections=3, so 97 are usable. Reserving 15 for
# operations (psql, pg_dump, monitoring) and 5 for the transient connections
# that migrations open at deploy/boot leaves 77 for application pools.
#
# The binding case is a ROLLING DEPLOY, where the old and new API are alive at
# once:
#
#     API_CLUSTER_WORKERS x API_DB_POOL_MAX x 2  +  WORKER_DB_POOL_MAX  <=  77
#
# At the shipped topology (1 API container, API_CLUSTER_WORKERS=1, 1 worker):
#     steady state    1x15      + 20  =  35  of 97   (36%)
#     rolling deploy  2x15      + 20  =  50  of 97   (52%)
#
# NOTE for API_CLUSTER_WORKERS > 1: each forked process is independently
# single-threaded, so its demand stays ~5 — connections do NOT need to scale
# proportionally. Re-solve the inequality before raising it (N=4 leaves room
# for only ~7 each, at which point raise max_connections or put PgBouncer in
# front instead of shrinking the pools further).
DB_POOL_MAX=15
DB_POOL_MIN=1
DB_POOL_IDLE_TIMEOUT=30000
# Bounded wait for a pooled connection, ms. Default 10000. node-postgres's own
# default is "wait forever", which turns pool exhaustion into a silent hang.
DB_POOL_CONNECTION_TIMEOUT=10000
# Role-specific pool ceilings live in each PART's -ONLY DATABASE subsection
# below: API_DB_POOL_MAX in PART 1 § API-ONLY, WORKER_DB_POOL_MAX in PART 2 §
# WORKER-ONLY. Unset means fall back to the shared DB_POOL_MAX above.

# [OPTIONAL] Server-side statement/transaction backstops, milliseconds; `0`
# disables (Postgres's own "no limit"). NOT in env.validation.ts's Joi schema
# (allowUnknown passes them through unvalidated) but genuinely read by
# `typeorm.config.ts`'s `timeoutMs()` helper. Role-specific
# `API_DB_STATEMENT_TIMEOUT`/`WORKER_DB_STATEMENT_TIMEOUT` (and the
# `_IDLE_IN_TRANSACTION_TIMEOUT` pair) win over these shared ones when set —
# same precedence as the pool ceilings above; see each PART's -ONLY DATABASE
# subsection. Defaults: API 30000 statement / 60000 idle-in-transaction;
# worker 120000 / 120000 (its jobs legitimately run bulk statements the API
# never issues). These BOUND what a single pooled session can do, so a future
# code path that leaks a transaction fails loudly and gives its connection
# back instead of holding a pool slot until someone notices. Calibration:
# across 1,090 `pg_stat_activity` samples taken during every load scenario,
# the longest ACTIVE statement observed was 0.000s.
#
# MIGRATIONS ARE NOT AFFECTED: they run on their own short-lived DataSource
# (`config/run-migrations-with-lock.ts` and the `migration:run` CLI), neither of
# which sets `extra`, so a long CREATE INDEX or table rewrite is exempt
# structurally rather than by choosing a lenient value.
#DB_STATEMENT_TIMEOUT=30000
#DB_IDLE_IN_TRANSACTION_TIMEOUT=60000

# [OPTIONAL] `DbPoolMetricsService`'s sample interval (db_pool_total/idle/
# waiting Prometheus gauges), ms. Default 15000. Read by MetricsModule, shared
# by both processes — each process reports its own pool's gauges.
#DB_POOL_METRICS_POLL_MS=15000


# ─────────────────────────────────────────────────────────────────────────
# SHARED — REDIS  (BullMQ queues, rate limiting, caches, Socket.IO adapter)
# ─────────────────────────────────────────────────────────────────────────

# [REQUIRED] The single source of Redis connection settings — host, port,
# credentials and database index are all parsed out of it. Use `rediss://` for
# TLS (managed Redis). There is no hardcoded host or port anywhere in the code.
#   redis://:PASSWORD@HOST:PORT/0   |   rediss://USER:PASSWORD@HOST:PORT/0
# Required by the shared Joi schema; both processes refuse to boot without it
# (QueueModule constructs `ProducerQueues` unconditionally in both roots).
REDIS_URL=rediss://default:CHANGE_ME@redis.example.com:6379/0

# [OPTIONAL] Escape hatches for the boot-time Redis maxmemory/eviction-policy
# audit (AppRedisService, QueueModule — shared). Set
# REDIS_MEMORY_CONFIG_VERIFIED_VIA_IAC=true on managed Redis where `CONFIG GET`
# is blocked but the policy is guaranteed by infrastructure code.
# REDIS_ALLOW_UNSAFE_MEMORY_CONFIG=true silences a genuinely unsafe policy — do
# not use it to paper over an eviction policy that can drop queued jobs.
#REDIS_ALLOW_UNSAFE_MEMORY_CONFIG=false
#REDIS_MEMORY_CONFIG_VERIFIED_VIA_IAC=true


# ─────────────────────────────────────────────────────────────────────────
# SHARED — QUEUES  (BullMQ producer-side defaults)
# ─────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Default retry policy applied to every enqueued job. Read
# wherever a job is enqueued — both the API (most producers) and the worker
# (jobs that enqueue follow-up jobs) go through the same `queue.constants.ts`.
QUEUE_DEFAULT_ATTEMPTS=5
QUEUE_BACKOFF_MS=3000
# Ceiling for exponential backoff, ms. Default 60000.
#QUEUE_BACKOFF_MAX_MS=60000

# [OPTIONAL] Namespace prefix for every BullMQ key. Set this when two
# environments share ONE Redis instance/database — without it, staging and
# production consume each other's jobs. Unset = no prefix. Must be identical
# on the API and the worker, or they address different queues entirely.
#QUEUE_ENV_PREFIX=prod


# ─────────────────────────────────────────────────────────────────────────
# SHARED — AUTH  (signing secrets only — everything else auth-related is
# API-only; see PART 1 § API-ONLY → AUTH)
# ─────────────────────────────────────────────────────────────────────────

# [REQUIRED] Signing secrets. MUST be two DIFFERENT high-entropy values.
# Generate each with: openssl rand -base64 48
#
# JWT_ACCESS_SECRET is genuinely read by BOTH services: AuthModule (API) signs
# and verifies access tokens with it, AND EmailModule's unsubscribe-token
# service (shared, worker-loaded) falls back to it when
# EMAIL_UNSUBSCRIBE_SECRET is unset.
#
# JWT_REFRESH_SECRET is functionally used ONLY by the API's AuthModule (token
# refresh/logout) — but it is `.required()` in the SAME Joi schema the worker
# also runs at boot (`ConfigModule.forRoot({ validate })` in worker.module.ts),
# so the WORKER SERVICE ALSO REFUSES TO BOOT if this is unset, even though it
# never uses the value. Set it on both services.
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_bytes_random
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_bytes_random


# ─────────────────────────────────────────────────────────────────────────
# SHARED — CORS  (also feeds the Socket.IO gateway CORS + handshake admission)
# ─────────────────────────────────────────────────────────────────────────

# [PROD-REQUIRED] Comma-separated allow-list of browser origins permitted to
# call this API with credentials. A wildcard is impossible here (cookie auth
# forbids it) and production REFUSES TO BOOT — on BOTH services, since the
# fail-fast lives in the shared schema — when this is unset. Each entry must
# be a full origin (scheme + host + optional port), with NO trailing slash and
# NO path.
#   Note: http://localhost:3000 and http://127.0.0.1:3000 are DIFFERENT origins.
#
# Genuinely read by the WORKER too: EmailModule and NotificationsModule (both
# shared, worker-loaded) fall back to the first entry here for APP_URL when
# APP_URL itself is unset, when composing links inside outbound
# emails/WhatsApp/notifications sent from the worker.
#
# ZiyaraTech Marketplace (contract C10, T027): this ONE variable feeds both
# main.ts's REST CORS AND ai-realtime.gateway.ts's Socket.IO gateway CORS
# (parseAllowedOrigins, src/config/cors-origins.ts) — add the Marketplace's
# deployed origin here, as a bare origin, or the AI widget's realtime
# handshake is silently refused from that origin exactly like a missing REST
# CORS entry would be.
# CSWSH: the SAME list is also enforced server-side on the WebSocket handshake
# itself (redis-io.adapter.ts -> ws-handshake-admission.ts) — the browser does
# not apply CORS to a WebSocket, so this is the only thing that stops another
# site from opening a credentialed socket. Every origin that hosts a realtime
# client (the app, the marketing site, the Marketplace) MUST be listed, exact
# match; an unlisted origin is refused at the handshake, on both transports.
# A request whose Sec-Fetch-Site is `cross-site` is refused as well, so the API
# host must be same-site with the app (e.g. api.example.com for app.example.com),
# not an unrelated default hostname. `COOKIE_SAMESITE=none` is only accepted in
# production when every entry here is https and non-loopback.
FRONTEND_ORIGIN=https://app.example.com,https://www.example.com,https://book.example.com


# ─────────────────────────────────────────────────────────────────────────
# SHARED — STORAGE  (Amazon S3, PRIVATE bucket)
# ─────────────────────────────────────────────────────────────────────────

# [OPTIONAL as a pair, but BOTH are needed together] With the bucket or region
# missing, every /uploads route fails CLOSED rather than degrading. Tenant
# verification documents, staff avatars, customer files and guest chat
# attachments all live here. Needed by the WORKER too: it renders and uploads
# PDFs (invoices, exports) via DocumentsModule/ReportExportModule.
# NO keys: credentials come from the runtime IAM role (ECS task role on AWS),
# and the bucket's default SSE-KMS encryption applies. On AWS the task
# definition sets these (infra/terraform/modules/platform/main.tf).
# [REQUIRED in production when STORAGE_PROVIDER=s3 - boot fails otherwise]
#STORAGE_PROVIDER=s3
#S3_BUCKET=zt-production-uploads-<account-id>
# [OPTIONAL] Defaults to AWS_REGION.
#S3_REGION=eu-central-1

# [OPTIONAL] Per-file upload cap, bytes. Default 10485760 (10 MB). Read at
# MODULE LOAD by `storage.constants.ts` (StorageModule, shared) — the value
# must come from the real process environment of BOTH services (a `.env`
# value applied later would be ignored).
UPLOAD_MAX_BYTES=10485760
# [OPTIONAL] Tighter cap for ANONYMOUS guest-chat attachments, bytes.
# Default 5242880 (5 MB). Same module-load caveat as UPLOAD_MAX_BYTES above.
# [OPTIONAL] Signed-URL lifetime for private object reads, seconds. Min 30.
# Used by the API serving a signed URL to a browser AND by the worker minting
# one for a rendered report/export it just uploaded.
SIGNED_URL_EXPIRES_SECONDS=300


# ─────────────────────────────────────────────────────────────────────────
# SHARED — EMAIL  (Amazon SES — the only provider)
# ─────────────────────────────────────────────────────────────────────────

# [OPTIONAL] true | false. Unset means ON in production, OFF in development.
# Off = the no-op provider (log only). On = Amazon SES; with no SES region the
# app refuses to send (and, in production, refuses to boot) — there is no
# fallback provider.
EMAIL_ENABLED=true

# [OPTIONAL] true = deliver inline on the request thread instead of via the
# worker queue. Only meaningful for an API-only deployment with no worker —
# read by EmailModule (shared, so the worker's own EmailService instance
# reads this flag too), but has no observable effect on worker behaviour;
# the worker always sends via EmailProcessor regardless of this value.
# Default false.
EMAIL_SYNC=false

# [REQUIRED in production when email is enabled - boot fails otherwise] Sender
# identity. The from-address domain must be a verified SES identity.
# EMAIL_FROM is "sender@domain" or
# "Name <sender@domain>"; a blank value is refused. The WORKER (EmailProcessor)
# is the process that sends, so set these on the worker service, not only on
# the API. EMAIL_FROM_NAME must not contain < > or ".
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=ZiyaraTech
#EMAIL_REPLY_TO=support@example.com

# [OPTIONAL] Fallback locale for templates with no recipient locale. Default en.
EMAIL_DEFAULT_LOCALE=en

# ── Amazon SES ───────────────────────────────────────────────────────────────────────────────
# No credentials: the SDK uses the runtime IAM role. EMAIL_FROM /
# EMAIL_FROM_NAME above still apply (an Arabic display name is RFC 2047-
# encoded automatically). [REQUIRED in production when email is enabled]
# a region: SES_REGION, or AWS_REGION (the ECS task definition sets it).
#SES_REGION=me-central-1
# [OPTIONAL] Configuration set: reputation metrics, account suppression and
# the bounce/complaint event stream. Set by the task definition on AWS.
#SES_CONFIGURATION_SET=zt-production
# [OPTIONAL] One SES call, ms. Default 10000; 1000-25000 (below the 30s
# BullMQ job lock — the SDK makes a single attempt, BullMQ owns retries).
#SES_HTTP_TIMEOUT_MS=10000
# [OPTIONAL, WORKER] SQS queue receiving SES bounce/complaint events
# (SES → SNS → SQS). Set = the worker's SesFeedbackConsumer long-polls it and
# suppresses hard-bounced/complaining campaign recipients. Unset = idle.
#SES_FEEDBACK_QUEUE_URL=https://sqs.me-central-1.amazonaws.com/<account>/zt-production-ses-feedback
# [PLATFORM] Set by ECS; used by the S3/SES/SQS clients.
#AWS_REGION=eu-central-1

# [OPTIONAL] HMAC secret for the stateless unsubscribe token (identifies a
# (tenant, email) pair only). Falls back to JWT_ACCESS_SECRET when unset, so
# no new mandatory deployment secret is introduced — set explicitly to use a
# dedicated key. Read by both services: the API resolves a clicked
# unsubscribe link, the worker signs the link when composing an email.
#EMAIL_UNSUBSCRIBE_SECRET=


# ─────────────────────────────────────────────────────────────────────────
# SHARED — WHATSAPP / META  (send path + credential decryption)
#
# This platform is an Independent Tech Provider: each clinic's own WABA, phone
# number and access token live ENCRYPTED on the WhatsappAccount entity, never
# in this file. The platform-app-level variables (Embedded Signup, webhook
# signature verification) are API-only — see PART 1 § API-ONLY → WHATSAPP/META.
# ─────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Graph API version / HTTP timeout used by the REAL send provider
# (`MetaWhatsappProvider`, WhatsappModule — shared). This is a SEPARATE code
# path from the platform Meta App config below (MetaConfig); it reads these
# two directly and has its own `v21.0`/`10000` defaults.
WHATSAPP_API_VERSION=v21.0
WHATSAPP_HTTP_TIMEOUT_MS=10000

# [OPTIONAL, LEGACY shared-number notification channel] Only the legacy
# `MetaWhatsappCloudProvider` (NotificationsModule, shared) reads these. The
# per-tenant Independent Tech Provider flow does NOT — leave both unset unless
# you are deliberately running the single shared-number model.
#WHATSAPP_PHONE_NUMBER_ID=
#WHATSAPP_ACCESS_TOKEN=

# [PROD-REQUIRED] Encrypts tenant provider credentials (WhatsApp/OAuth tokens)
# at rest. Must decode to EXACTLY 32 bytes, base64 or hex. BOTH services
# refuse to boot in production without it (shared schema fail-fast) — and
# BOTH genuinely need it at runtime: the API decrypts/encrypts on the
# onboarding path, the worker decrypts a tenant's credential to actually send.
# Generate with: openssl rand -base64 32
# Rotating this value makes every already-stored credential undecryptable.
CREDENTIALS_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes

# [OPTIONAL] Turns per patient WhatsApp number ("whatsapp-contact" AI rate
# limit). Genuinely enforced from the WORKER: an inbound WhatsApp message is
# verified and enqueued by the API's webhook controller, but the AI turn
# itself (and this rate-limit check, `AiWsRateLimitService`, provided
# directly by WhatsappModule to avoid a circular import with
# AiRealtimeModule) runs inside `WhatsappWebhookProcessor` in the worker.
# Every OTHER `AI_WS_RATE_LIMIT_*`/`AI_GUEST_DAILY_TURN_BUDGET` variable below
# (PART 1 § API-ONLY → AI) is checked only from the realtime WebSocket
# gateway, which exists only in the API process.
AI_WHATSAPP_CONTACT_MAX_TURNS=20
AI_WHATSAPP_CONTACT_WINDOW_SECONDS=60
AI_WHATSAPP_CONTACT_DAILY_MAX_TURNS=300

# [OPTIONAL] Shared degraded-mode fallback used by the rate limiters above
# (and by the API's own login-protection/WS limiters) while Redis is
# unavailable. Factor must be in (0, 1] — degraded mode is never MORE
# permissive than healthy mode. Width bounds the in-memory counter table:
# 256-65536.
AUTH_ABUSE_DEGRADED_FACTOR=0.5
AUTH_ABUSE_FALLBACK_WIDTH=4096

# [OPTIONAL] Client-address trust for the per-IP throttlers (WELL-ARCHITECTED
# REVIEW SEC-02). 0 (default) = legacy: req.ip is the socket peer. 1 = trust
# exactly ONE reverse proxy, the AWS ALB (which APPENDS the real peer to
# X-Forwarded-For; Terraform pins that mode). Only 0 or 1 is accepted — a larger
# hop count would trust an entry the caller controls. Set 1 ONLY behind that
# ALB; on a platform whose proxy does not append, leave 0.
TRUST_PROXY_HOPS=0
# [OPTIONAL] Proof-of-edge secret (>= 32 chars; requires TRUST_PROXY_HOPS=1).
# When set, a request presenting the same value in X-ZT-Edge-Token is keyed on
# the client address the trusted edge (Vercel) forwarded instead of the edge's
# own address. Unset = inert. Nothing sends the header until the Vercel side is
# configured to; never put this in a NEXT_PUBLIC_* variable.
#EDGE_PROXY_TOKEN=
# ─────────────────────────────────────────────────────────────────────────
# SHARED — AI  (OpenAI + pgvector RAG)
#
# Every key in this subsection is read by AiModule/AiMemoryModule (both
# imported by AppModule AND WorkerModule) — a live chat turn can be served
# either synchronously off the API's realtime gateway, or picked up
# asynchronously by the worker's AiProcessor (batch mode, WhatsApp-originated
# turns, knowledge-base ingestion). The API-only WS-gateway-specific rate
# limits and memory-recall toggle live in PART 1 § API-ONLY → AI instead.
# ─────────────────────────────────────────────────────────────────────────

# [OPTIONAL] With no key the AI falls back to the Noop provider and RAG
# degrades to keyword search — the app still boots and serves.
OPENAI_API_KEY=sk-CHANGE_ME

# [OPTIONAL] Models. OPENAI_EMBEDDING_DIM MUST match the vector(N) column the
# pgvector bootstrap created — changing it requires a re-embed. (The
# `AiPgVector` MIGRATION also reads OPENAI_EMBEDDING_DIM directly, at
# migration time — a third, separate process root, `npm run migration:run`,
# outside this file's PART 1 / PART 2 split; keep it consistent there too.)
#
# PLATFORM MODEL POLICY: the model the platform actually runs on is
# `ai.default_model`, set by a super admin at /platform/system-settings — check
# GET /platform/settings/typed for its current value AND whether that value is
# a deliberate override or just the shipped default (F-22: this used to be
# invisible; the "source" field on that response now says which it is).
#
# AI_FALLBACK_MODEL must be one of the two permitted chat models —
# gpt-5.6-luna or gpt-5.6-terra. Any other value fails validation at boot.
# It is NOT the effective model (see above) — it is (1) the rarely-reached
# default for a request that names no model at all, and (2) the model
# OpenAiChatProvider's circuit breaker substitutes to when the routed model
# trips (AI_CIRCUIT_BREAKER_* below).
#
# The embedding model is a different class of model entirely (text-embedding-*,
# not a chat model) and is deliberately out of scope for that policy.
AI_FALLBACK_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

# [OPTIONAL] Request policy. The SDK's own retry loop is disabled;
# OpenAiRequestPolicy is the sole owner of retries.
OPENAI_REQUEST_TIMEOUT_MS=30000
OPENAI_PROVIDER_MAX_RETRIES=2
OPENAI_RETRY_BASE_MS=500

# [OPTIONAL] F-22 runtime fallback: after this many CONSECUTIVE failures on a
# model (once OpenAiRequestPolicy's own retries above are exhausted),
# OpenAiChatProvider redirects subsequent calls to AI_FALLBACK_MODEL for the
# cooldown window below. Unproven live — first sizing guess, not measured.
AI_CIRCUIT_BREAKER_THRESHOLD=3
AI_CIRCUIT_BREAKER_COOLDOWN_MS=60000

# [OPTIONAL] Prompt budgets, tokens. AI_PROMPT_MAX_INPUT_TOKENS is the binding
# per-call input cap — routing to a larger-context model must not raise it.
AI_PROMPT_SYSTEM_TOKENS=2000
AI_PROMPT_HISTORY_TOKENS=5000
AI_PROMPT_RAG_TOKENS=2500
AI_PROMPT_MEMORY_TOKENS=800
AI_PROMPT_TOOL_OUTPUT_TOKENS=1200
AI_PROMPT_TOOL_SCHEMA_TOKENS=6000
AI_PROMPT_MAX_INPUT_TOKENS=12000
AI_PROMPT_MAX_OUTPUT_TOKENS=800
#AI_PROMPT_BOOKING_CONTEXT_TOKENS=500
# [OPTIONAL, undocumented in env.validation.ts's Joi schema — a pre-existing
# gap this reorganization found, not introduced by it; see the final report]
# Per-agent prompt-budget sub-allowance, tokens. Default 1000
# (`ai-prompt-budget.service.ts`).
#AI_PROMPT_AGENT_TOKENS=1000
#AI_PROMPT_DIRECTIVES_TOKENS=1600
# Fallback context window for a model with no registry entry.
AI_MODEL_CONTEXT_WINDOW_TOKENS=16384

# [OPTIONAL] Per-turn tool-call ceiling and enqueue timeout.
AI_MAX_TOOL_CALLS_PER_ITERATION=10
AI_QUEUE_ENQUEUE_TIMEOUT_MS=8000

# [OPTIONAL, undocumented in env.validation.ts's Joi schema — same
# pre-existing gap as AI_PROMPT_AGENT_TOKENS above] true | false, default
# true. Master switch for the AI tool-scope guard (`ai-execution.service.ts`).
#AI_SCOPE_GUARD_ENABLED=true

# [OPTIONAL] Prompt-similarity disclosure guard.
AI_PROMPT_SIMILARITY_THRESHOLD=0.6
AI_PROMPT_SIMILARITY_SHINGLE_SPAN=8

# [OPTIONAL] Model routing. OFF by default: with ENABLED=false every turn runs
# `ai.default_model` (or the agent's own pinned model). Roll out by percent,
# never all at once. ECONOMY / POWERFUL must be ids present in
# AI_MODEL_REGISTRY — i.e. gpt-5.6-luna or gpt-5.6-terra.
AI_MODEL_ROUTING_ENABLED=false
AI_MODEL_ROUTING_ROLLOUT_PERCENT=0
AI_ECONOMY_MODEL=gpt-5.6-luna
#AI_POWERFUL_MODEL=
#AI_POWERFUL_FEATURES=
#AI_POWERFUL_ROUTES=
AI_MODEL_ROUTING_STRICT=true

# [OPTIONAL] Embedding cache (Redis) — an optimization, never a correctness
# dependency. Bump AI_EMBEDDING_VERSION to invalidate every cached vector.
AI_EMBEDDING_CACHE_ENABLED=true
AI_EMBEDDING_QUERY_CACHE_TTL_SECONDS=86400
AI_EMBEDDING_CONTENT_CACHE_TTL_SECONDS=2592000
AI_EMBEDDING_VERSION=v2

# [OPTIONAL] Batch execution mode. The mode is always derived server-side from
# the FEATURE; no DTO exposes it, so a client can never select it. (The
# scheduling cron for the batch-status poll sweep, AI_BATCH_POLL_CRON, is
# Worker-only — see PART 2 § WORKER-ONLY → AI.)
AI_BATCH_ENABLED=false
AI_BATCH_EMBEDDING_CHUNK_THRESHOLD=200
AI_STANDARD_MAX_EMBED_CHUNKS=512
#AI_BATCH_COMPLETION_WINDOW=24h
#AI_BATCH_SUBMIT_LEASE_SECONDS=120
#AI_BATCH_SUBMIT_RECONCILE_GRACE_SECONDS=300
#AI_BATCH_SUBMIT_MAX_ATTEMPTS=5
#AI_BATCH_POLL_PAGE_SIZE=25
#AI_BATCH_POLL_LEASE_SECONDS=60
#AI_BATCH_POLL_BACKOFF_BASE_SECONDS=30
#AI_BATCH_POLL_BACKOFF_MAX_SECONDS=900
#AI_BATCH_MAX_AGE_HOURS=26
#AI_TRAINING_FINALIZE_GRACE_MINUTES=30

# [OPTIONAL] Data residency — a compliance policy, orthogonal to execution
# mode. OFF by default. When ON, a tenant whose deployment is enabled but
# unavailable FAILS CLOSED; the request is never redirected to the global
# region. Enabling this does not by itself assert any legal guarantee.
AI_DATA_RESIDENCY_ENABLED=false
#AI_RESIDENCY_REQUIRED_FEATURES=

# [OPTIONAL] Retrieval.
RAG_TOP_K=5
HNSW_EF_SEARCH=60
AI_PGVECTOR_ENABLED=true
RAG_MIN_SCORE=0.5

# [OPTIONAL] Training-file upload cap, bytes. Default 10485760 (10 MB).
AI_TRAINING_FILE_MAX_BYTES=10485760

# [OPTIONAL] Cost-attribution price catalog override, as JSON. Unset uses the
# built-in catalog.
#AI_PRICE_CATALOG_JSON=

# [OPTIONAL] ai_tool_calls retention sweep, days.
AI_TOOL_CALL_RETENTION_DAYS=90


# ─────────────────────────────────────────────────────────────────────────
# SHARED — PAYMENTS  (Tap)
#
# PaymentsModule/SubscriptionBillingModule are imported by BOTH services — the
# worker's SettlementsProcessor, SubscriptionsProcessor, RefundsProcessor and
# PaymentsProcessor read every key below directly.
# ─────────────────────────────────────────────────────────────────────────

# [OPTIONAL] tap | noop. Default tap. In PRODUCTION with PAYMENT_PROVIDER=tap
# (including the unset default) the Tap block below is REQUIRED in practice, but an
# absent value does NOT stop the boot (env.validation.ts only checks values that are
# present): Tap calls then fail at call time, subscription checkout is not offered
# without TAP_MERCHANT_ID, and the preflight below is what flags the gap. `noop`
# explicitly disables live payments.
# Before relying on it, run `node dist/src/tap-preflight.js --expect-active`
# against the real environment — DEPLOYMENT.md §11,
# infra/runbooks/tap-payments-rollout.md.
PAYMENT_PROVIDER=tap

# ── Tap Payments (https://developers.tap.company) ──────────────────────────
# Server keys come from the Tap dashboard: Accounts > Operators ID > MERCHANT.
# Secret keys are BACKEND-ONLY — never expose them to the frontend or logs.
# The hosted-redirect flow needs no public/SDK key, so none is read — the
# TAP_*_PUBLIC_KEY / TAP_DOMAIN_* / TAP_BUNDLE_* names are NOT used by any code.
# [OPTIONAL] sandbox | live. Selects which key pair is active. Defaults to
# sandbox. REQUIRED explicitly in production when PAYMENT_PROVIDER=tap.
TAP_ENV=
# The dashboard "Merchant ID" — ZiyaraTech's OWN merchant account. Required for
# SUBSCRIPTION payments: every subscription charge is sent with it and is only booked
# when Tap echoes the same id back (a charge on any other account is held + ALERT).
TAP_MERCHANT_ID=
# sk_test_… — used when TAP_ENV=sandbox. Must start with sk_test_.
TAP_TEST_SECRET_KEY=
# sk_live_… — used when TAP_ENV=live. Must start with sk_live_.
TAP_LIVE_SECRET_KEY=
# Public https URL Tap posts webhooks to (NOT localhost; use a tunnel in dev):
#   https://<api-host>/api/v1/payments/webhooks/tap
# Required in production when PAYMENT_PROVIDER=tap.
TAP_WEBHOOK_URL=
# [OPTIONAL] commerce_platform_… issued by Tap on platform activation; needed
# to charge on a clinic's behalf (clinic-merchant routing).
TAP_PLATFORM_ID=
# [OPTIONAL] Per-request timeout toward Tap, ms. Default 15000.
#TAP_REQUEST_TIMEOUT_MS=15000
# [OPTIONAL] Payable window of a hosted charge, minutes (5–60). Unset = Tap's own
# default (30). Opt-in until confirmed in the Tap sandbox.
#TAP_CHARGE_EXPIRY_MINUTES=30
# [OPTIONAL] true = save the clinic's card at checkout and renew it without the
# clinic present (merchant-initiated). Leave false until Tap has activated BOTH
# Save Card and non-3DS merchant-initiated charges on the account (errors 1108/1109).
# While false, a checkout is a plain payment and a renewal asks the clinic to pay.
TAP_RECURRING_ENABLED=false
# [OPTIONAL] Days a paid-plan subscription may wait in PENDING_PAYMENT (its first
# payment never came) before the daily sweep cancels it and voids its unpaid
# invoices. Default 7; 0 switches the sweep off.
#SUBSCRIPTION_PENDING_PAYMENT_TTL_DAYS=7
# [OPTIONAL] true = patients pay a clinic's booking online and Tap settles straight to
# the clinic's own merchant account (Tap Platform). Requires TAP_PLATFORM_ID, and each
# clinic must be onboarded + approved first. While false (or the clinic is not
# approved) a booking is confirmed as "pay at the clinic" and no pay link is issued.
TAP_BOOKING_PAYMENTS_ENABLED=false
# [OPTIONAL] Minutes after which a booking still waiting for payment is cancelled and its
# slot released (a payment attempt opened in the last 30 minutes is never cut off).
# Default 15; 0 switches the sweep off. A payment that arrives AFTER the cancellation is
# never treated as valid — it is raised as a reconciliation exception for a person.
#UNPAID_BOOKING_TTL_MINUTES=15
# [OPTIONAL] true = a clinic charge is only accepted when Tap echoes EXACTLY the clinic's
# merchant id (create time and webhook). Default false until the echoed form is confirmed
# on a live Tap Platform account; otherwise only "our own account / no merchant" is refused.
#TAP_STRICT_MERCHANT_ECHO=false
# [OPTIONAL] Tap documents a separate "segment" secret key for the Lead/Connect
# (clinic onboarding) APIs. Unset = the active secret key above is used. Must start
# with sk_test_ (TAP_ENV=sandbox) or sk_live_ (TAP_ENV=live).
TAP_SEGMENT_SECRET_KEY=
# [OPTIONAL] API base. Default https://api.tap.company
#TAP_API_BASE=https://api.tap.company

# [OPTIONAL] Platform commission taken per transaction.
PLATFORM_FEE_PERCENT=0
PLATFORM_FEE_FIXED=0

# [OPTIONAL] Refund and payment reconciliation sweeps, minutes. Not in
# env.validation.ts's Joi schema (commented out there) but genuinely read by
# `refund-recovery.service.ts` / `payments.config.ts` (PaymentsModule).
REFUND_REAPER_STALE_MIN=10
REFUND_REAPER_HARDFAIL_MIN=120
PAYMENTS_RECON_STALE_MIN=15
PAYMENTS_RECON_HARDFAIL_MIN=240


# ─────────────────────────────────────────────────────────────────────────
# SHARED — EXTERNAL SERVICES  (outbound webhooks, integration SSRF guard)
# ─────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Outbound webhook delivery policy. Read when the API/worker
# enqueue a delivery (`platform/webhook-delivery.service.ts`, PlatformModule,
# shared) AND by the worker's own delivery attempt
# (`worker/processors/webhook-delivery.processor.ts`).
WEBHOOK_DELIVERY_TIMEOUT_MS=10000
WEBHOOK_DELIVERY_MAX_ATTEMPTS=6
WEBHOOK_DELIVERY_BACKOFF_MS=5000

# [OPTIONAL] Workflow HTTP-action timeout, ms. Default 8000. Read by
# `workflow-action.executor.ts` (WorkflowModule, shared — a workflow action
# can fire from an event during an HTTP request or from WorkflowProcessor).
#WORKFLOW_WEBHOOK_TIMEOUT_MS=8000

# [DEV-ONLY] SSRF guard escape hatches for tenant-supplied integration base
# URLs (`integration-url-guard.ts`, IntegrationPlatformModule — shared: both
# the API's connection-test endpoint and the worker's sync/import processors
# make outbound calls to tenant-configured endpoints through this guard).
# Outside production both restrictions are already relaxed; setting either to
# `true` in PRODUCTION permits plain-HTTP / private-network targets. Leave
# both unset in production.
#INTEGRATION_ALLOW_INSECURE_BASE_URL=false
#INTEGRATION_ALLOW_PRIVATE_BASE_URL=false

# [DEV-ONLY] Registers the in-memory test OAuth provider
# (IntegrationPlatformModule, shared). Never `true` in production.
#INTEGRATION_OAUTH_TEST_PROVIDER=false


# ─────────────────────────────────────────────────────────────────────────
# SHARED — BILLING / ACCESS POLICY
# ─────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Days a lapsed subscription stays usable before hard expiry.
# Read by SubscriptionBillingModule (shared) AND the worker's own
# SubscriptionsProcessor.
SUBSCRIPTION_GRACE_DAYS=14

# [OPTIONAL] shadow | enforce. Default enforce. `shadow` resolves the tenant
# access decision exactly as `enforce` does and then LOGS a denial instead of
# acting on it — the deny log is the regression list for a staged rollout.
# Shadow covers ENTITLEMENT only: authentication, RBAC, tenant lifecycle, rate
# limits and metering all keep blocking. An unrecognised value is treated as
# `enforce`, so a typo can never silently disable authorization.
# SubscriptionBillingModule is shared — both an HTTP request (API) and a
# background usage check (worker) resolve access through the same gate.
#ACCESS_POLICY_MODE=enforce

# [OPTIONAL] Access-decision memo cache TTL, ms. Default 5000. <= 0 disables
# the cache and resolves every gate fresh.
#ACCESS_DECISION_CACHE_TTL_MS=5000


# ─────────────────────────────────────────────────────────────────────────
# SHARED — ANALYTICS / RETENTION
# ─────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Redis-backed read-through cache for analytics queries
# (AnalyticsModule, shared — analytics can be read from the API's dashboard
# endpoints or aggregated by the worker's AnalyticsProcessor).
ANALYTICS_CACHE_ENABLED=true
ANALYTICS_CACHE_TTL=60

# [OPTIONAL] Retention sweeps, in days. Genuinely triggered by the worker's
# maintenance crons, but the retention-day CONSTANT itself is read at
# construction time in both processes since the owning module is shared.
ANALYTICS_EVENT_RETENTION_DAYS=90
#NOTIF_LOG_RETENTION_DAYS=90
#PLATFORM_API_LOG_RETENTION_DAYS=30
#PLATFORM_WEBHOOK_LOG_RETENTION_DAYS=90
# [OPTIONAL, undocumented in env.validation.ts's Joi schema] Internal
# staff-notification retention, days (`internal-notification-read.service.ts`,
# NotificationsModule). Defaults: 30 (read receipts), 180 (hard ceiling).
#INTERNAL_NOTIFICATION_READ_RETENTION_DAYS=30
#INTERNAL_NOTIFICATION_MAX_RETENTION_DAYS=180
# [OPTIONAL, undocumented in env.validation.ts's Joi schema] Max fan-out for
# one internal staff notification (`internal-notification.service.ts`).
# Default 200.
#INTERNAL_NOTIFICATION_MAX_FANOUT=200

# [OPTIONAL] Per-tenant notification send ceiling, messages/minute. Read at
# module load in `notification-dispatch.service.ts` (NotificationsModule,
# shared).
#NOTIF_RATE_PER_MIN=120

# [OPTIONAL, undocumented in env.validation.ts's Joi schema] Bulk export sizing
# (`report-export.constants.ts`, ReportExportModule — shared: the API decides
# sync-vs-async at request time, the worker executes the async job and sweeps
# expired exports).
#EXPORT_SYNC_ROW_THRESHOLD=
#EXPORT_RETENTION_DAYS=
#EXPORT_CONCURRENCY_CAP_PER_TENANT=


# ─────────────────────────────────────────────────────────────────────────
# SHARED — OBSERVABILITY  (Prometheus)
# ─────────────────────────────────────────────────────────────────────────

# [PROD-REQUIRED in practice] Static bearer token a Prometheus scraper presents
# to GET /metrics. A scraper has no tenant/user JWT, so this is deliberately
# independent of the business auth stack. In PRODUCTION an unset token makes
# /metrics answer 401 (fails closed); in dev/test unset means the endpoint is
# open. Checked by BOTH services: the API's own `/metrics` route
# (`metrics-auth.guard.ts`) AND the worker's standalone metrics HTTP listener
# (`start-metrics-http-server.ts`, PART 2 § WORKER-ONLY). Generate with:
# openssl rand -hex 32
METRICS_TOKEN=CHANGE_ME_hex_32_bytes


###############################################################################
# ══ API-ONLY ══  Do NOT set these on the Worker ECS service — unused there
###############################################################################

# ─────────────────────────────────────────────────────────────────────────
# API-ONLY — APP
# ─────────────────────────────────────────────────────────────────────────

# [OPTIONAL] HTTP listen port for the API process. Default: 3000.
# main.ts binds 0.0.0.0:$PORT. Platforms that inject their own PORT (ECS task definition,
# Heroku, Cloud Run) need nothing set here.
PORT=3000

# [OPTIONAL] Runs the idempotent startup seeder (roles, permissions, feature
# catalog, and the super-admin from ADMIN_EMAIL/ADMIN_PASSWORD) on every boot.
# `SeedModule` is imported only by AppModule — the worker never runs it.
# Service default: true. RECOMMENDED `false` in production — provision the
# super-admin once via `npm run seed` instead of on every container start.
SEED_ON_STARTUP=false

# [OPTIONAL] Swagger / integration documentation mounts, mounted only in
# main.ts (`mountApiDocs`). Two INDEPENDENT switches; neither defaults from
# the other. Resolved default: `false` in production, `true` otherwise. Leave
# ENABLE_API_DOCS false in production — the internal document exposes the full
# route surface unauthenticated.
# ENABLE_INTEGRATION_DOCS is the PARTNER guide (/docs/integrations): only the 14
# external API-key routes plus the written integration guide. Set it true in
# production only when you deliberately want to publish that guide to partners
# (see DEPLOYMENT.md, "Partner API reference").
ENABLE_API_DOCS=false
ENABLE_INTEGRATION_DOCS=false

# [OPTIONAL] API process-level scaling (Node `cluster`), main.ts only. 1-8,
# default 1. 1 = single process, byte-identical to no clustering. Raising it
# multiplies DB connections by API_DB_POOL_MAX per forked process — size
# against Postgres's own max_connections before changing it. Has no meaning
# on the worker, which never forks.
API_CLUSTER_WORKERS=1

# [OPTIONAL] Super-admin bootstrap credentials, consumed ONLY by the seeder
# (SeedModule, API-only). In production the seeder SKIPS admin creation when
# these are unset (it never fabricates a known password). Set them for a
# first provisioning run, then remove them from the running deployment's
# environment.
#ADMIN_EMAIL=admin@example.com
#ADMIN_PASSWORD=CHANGE_ME_strong_unique_password


# ─────────────────────────────────────────────────────────────────────────
# API-ONLY — DATABASE
# ─────────────────────────────────────────────────────────────────────────

# [OPTIONAL] true | false, default false. When a REQUIRED DB-enforced integrity
# guard could not be installed at boot, `GET /system/health/readiness` always
# reports status="degraded" with a COUNT (never an object name — the route is
# public and naming a missing uniqueness guard would tell an anonymous caller
# which duplicate to attempt). Set this to true to escalate that to HTTP 503,
# for an orchestrator that routes traffic on readiness and wants fail-closed
# behaviour. Default false: pulling every instance out of rotation turns a
# missing index into a total outage, which is not automatically the better
# trade. Read only by `health.controller.ts` — HealthModule is API-only.
SCHEMA_GUARD_FAIL_READINESS=false

# [OPTIONAL] Per-role pool ceiling for the API process specifically. Unset
# falls back to the shared DB_POOL_MAX (see PART 1 § SHARED → DATABASE).
API_DB_POOL_MAX=15
# [OPTIONAL, undocumented in env.validation.ts's Joi schema] Per-role
# statement/idle-in-transaction backstops for the API specifically. Unset
# falls back to the shared DB_STATEMENT_TIMEOUT/DB_IDLE_IN_TRANSACTION_TIMEOUT.
#API_DB_STATEMENT_TIMEOUT=30000
#API_DB_IDLE_IN_TRANSACTION_TIMEOUT=60000

# [OPTIONAL] Informational only — this application has no way to read
# Postgres's own `max_connections` setting, so the boot-time capacity
# estimate `cluster-bootstrap.ts` logs (main.ts only) falls back to a fixed
# threshold guess when this is unset. Supplying the real value
# (`SHOW max_connections;`, run by an operator — read-only) turns that guess
# into a precise percentage. Has no effect on the worker.
#DB_MAX_CONNECTIONS=100


# ─────────────────────────────────────────────────────────────────────────
# API-ONLY — AUTH  (JWT lifetimes, cookies, CSRF, abuse resistance)
#
# Everything below is read exclusively inside AuthModule / GuestChatModule /
# PublicBookingModule / AiRealtimeModule — none of which are imported by
# WorkerModule.
# ─────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Token lifetimes (`15m`, `7d`, `1h`, ...).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Anonymous public-chat/booking session token lifetime. Default 1d.
GUEST_SESSION_TTL=1d

# [OPTIONAL] Cookie attributes. `Secure` is NOT configurable — it is derived
# from NODE_ENV=production, so production cookies are always Secure.
#   COOKIE_SAMESITE : lax | strict | none. Service default `lax`.
#                     Use `none` ONLY when the SPA is on a different site than
#                     the API (true cross-site). `none` outside production is a
#                     boot error, because it would be sent without Secure.
#   COOKIE_DOMAIN   : unset = host-only cookies (correct for both a same-origin
#                     Next.js rewrite and a cross-origin SPA). Set it only to
#                     deliberately share cookies across subdomains.
# NOTE: this pair (and PUBLIC_COOKIE_SAMESITE/PUBLIC_COOKIE_DOMAIN below) is
# also validated by the SAME shared Joi schema the worker runs at boot — an
# invalid combination (e.g. `none` outside production) would fail the
# worker's boot too if it were ever set there. In practice, simply don't set
# these on the Worker ECS service at all.
COOKIE_SAMESITE=lax
#COOKIE_DOMAIN=example.com
#
# [OPTIONAL] Direct API routing (residency plan P9) — scope of the READABLE
# `csrf_token` / session-hint cookie ONLY. Unset falls back to COOKIE_DOMAIN, so
# nothing changes until it is set. Bare hostname, NO leading dot: `example.com`
# (`.example.com` fails the hostname validator and the app will not boot).
#   Use it instead of COOKIE_DOMAIN when the browser calls this API host
#   directly (frontend NEXT_PUBLIC_API_BASE_URL set): the SPA on the app host must
#   read the hint, but the access/refresh cookies should stay host-only on THIS
#   host so the page-serving tier is never sent a bearer credential. Requires
#   FRONTEND_ORIGIN to list the app origin and the two hosts to share a
#   registrable domain. Must equal the frontend's NEXT_PUBLIC_COOKIE_DOMAIN.
#CSRF_COOKIE_DOMAIN=example.com

# [OPTIONAL] Data governance (residency plan P12 / P13). NONE of these has a default,
# on purpose: how long a record may be kept, and how fast a data-subject request must
# be answered, are legal inputs that this system does not guess.
#
#   RETENTION_*_DAYS   age (whole days, >= 1) after which an operational copy is removed.
#                      Unset = KEEP. Run `npm run retention:run` (a dry run) then
#                      `npm run retention:run -- --apply`. Targets: delivery logs that hold
#                      recipient addresses, processed raw webhook payloads, finished
#                      reminders' variables, AI chat transcripts. Clinical, identity,
#                      payment and audit data have NO retention target at all.
#   DSR_RESPONSE_DAYS  deadline stamped on a new data-subject request. Unset = no due date.
#RETENTION_EMAIL_LOGS_DAYS=
#RETENTION_WHATSAPP_WEBHOOKS_DAYS=
#RETENTION_SCHEDULED_NOTIFICATION_VARIABLES_DAYS=
#RETENTION_AI_TRANSCRIPTS_DAYS=
#DSR_RESPONSE_DAYS=

# [OPTIONAL] Per-cookie override for the TWO anonymous patient cookies only
# (`guest_token`, `booking_session_id`). Defaults to the COOKIE_SAMESITE /
# COOKIE_DOMAIN values above when unset.
#PUBLIC_COOKIE_SAMESITE=lax
#PUBLIC_COOKIE_DOMAIN=example.com

# [OPTIONAL] Password reset / staff invitation token lifetimes, in minutes.
PASSWORD_RESET_TTL_MIN=30
#STAFF_INVITATION_TTL_MIN=10080

# [DEV-ONLY] Echoes password-reset tokens back in the API response for local
# testing. `true` together with NODE_ENV=production is a HARD BOOT ERROR —
# checked by the shared schema, so it would also block a Worker boot if ever
# set `true` there; simply leave it unset on the Worker service.
AUTH_EXPOSE_RESET_TOKEN=false

# [OPTIONAL] Login lockout.
AUTH_LOGIN_MAX_FAILED_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_TTL_SECONDS=900
# With a known client address the limit above is per (email + client); this
# is the email-wide ceiling across all addresses (RL-05).
AUTH_LOGIN_IDENTITY_BACKSTOP_ATTEMPTS=20

# [OPTIONAL] Refresh-token rotation replay tolerance (a legitimate client that
# retries a refresh after a network blip must not be treated as a thief).
AUTH_REFRESH_RETRY_WINDOW_SECONDS=30
AUTH_REFRESH_MAX_RETRIES=3
AUTH_REFRESH_RETRY_MIN_AGE_MS=0

# [OPTIONAL] Forgot-password abuse bounds.
AUTH_FORGOT_PASSWORD_MAX_PER_WINDOW=5
AUTH_FORGOT_PASSWORD_WINDOW_SECONDS=900

# [OPTIONAL] Reset-password abuse bounds — two independent layers.
AUTH_RESET_PASSWORD_MAX_PER_ACCOUNT=10
AUTH_RESET_PASSWORD_INVALID_CEILING=100
AUTH_RESET_PASSWORD_WINDOW_SECONDS=900

# [OPTIONAL] Per-identity registration bound.
AUTH_REGISTER_OWNER_MAX_PER_IDENTITY=3
AUTH_REGISTER_OWNER_WINDOW_SECONDS=3600

# [PROD-REQUIRED] Endpoint-wide registration ceiling per window. Bounds an
# attacker rotating email / slug / commercial-registration-number to create
# tenants in bulk. Functionally used ONLY by the API's registration endpoint
# — but validated by the SAME shared schema the Worker also runs, so a
# PRODUCTION Worker boot ALSO fails if this is unset there. There is
# deliberately NO production default: size it from real expected legitimate
# signup volume. Non-production defaults to 1000. Simplest fix: set the same
# value on both ECS services (or leave it off the worker only if you have
# verified NODE_ENV isn't `production` there, which is unusual).
AUTH_REGISTER_OWNER_ENDPOINT_CEILING=1000


# ─────────────────────────────────────────────────────────────────────────
# API-ONLY — EMAIL
# ─────────────────────────────────────────────────────────────────────────

# (No email webhook any more: bounce/complaint feedback arrives through the
# SES → SNS → SQS consumer on the worker — see SES_FEEDBACK_QUEUE_URL.)


# ─────────────────────────────────────────────────────────────────────────
# API-ONLY — WHATSAPP / META  (platform Meta App config — Embedded Signup +
# inbound webhook signature verification; never used by a worker processor)
# ─────────────────────────────────────────────────────────────────────────

# [OPTIONAL as a group — but PARTIAL configuration is a HARD BOOT ERROR in
# production, on BOTH services (shared schema) if any one of the four is set
# without the rest]. Either set all four, or unset every META_*/WHATSAPP_*
# variable to leave WhatsApp explicitly disabled. A half-configured app
# leaves the webhook signature pair or Embedded Signup silently broken.
# Simplest fix: only ever set these on the API service; leave all four unset
# on the Worker service.
META_APP_ID=CHANGE_ME
META_APP_SECRET=CHANGE_ME
META_EMBEDDED_SIGNUP_CONFIG_ID=CHANGE_ME
META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_random_string

# [OPTIONAL] Graph API version, pattern vNN.N. Default v21.0. Used only by
# `MetaConfig.graphUrl()` (Embedded Signup / onboarding HTTP calls).
META_GRAPH_API_VERSION=v21.0
# [OPTIONAL] Graph API HTTP timeout, ms. Min 1000, default 10000. Same
# onboarding-only scope as META_GRAPH_API_VERSION above.
META_HTTP_TIMEOUT_MS=10000

# [OPTIONAL, LEGACY ALIASES] Still honoured as a fallback by MetaConfig so an
# in-flight webhook does not break on the rename. Prefer the META_* names above
# and remove these once every environment has migrated.
#WHATSAPP_APP_SECRET=
#WHATSAPP_VERIFY_TOKEN=


# ─────────────────────────────────────────────────────────────────────────
# API-ONLY — AI  (realtime WebSocket gateway + orchestrator)
#
# `AiRealtimeModule` and `AiOrchestratorModule` are imported only by
# AppModule.
# ─────────────────────────────────────────────────────────────────────────

# [OPTIONAL] WebSocket turn rate limits for the two identity classes that only
# ever connect over the `/ai` gateway (dashboard users, the public guest chat
# widget). The THIRD identity class this same rate-limit service supports —
# WhatsApp contacts — is checked from the WORKER instead; see
# AI_WHATSAPP_CONTACT_* in PART 1 § SHARED → WHATSAPP / META.
AI_WS_RATE_LIMIT_AUTHENTICATED_MAX_TURNS=30
AI_WS_RATE_LIMIT_AUTHENTICATED_WINDOW_SECONDS=60
AI_WS_RATE_LIMIT_GUEST_MAX_TURNS=15
AI_WS_RATE_LIMIT_GUEST_WINDOW_SECONDS=60

# [OPTIONAL] Abuse bounds beyond the per-identity limits above (0 = off).
# GUEST_SOURCE counts turns per network address across every guest identity it
# mints; it only means something if the address the server sees is the visitor's
# (behind a proxy that does not forward it, all visitors share one - size it for
# the whole site, or set 0). GUEST_DAILY_TURN_BUDGET is a platform-wide ceiling
# on anonymous turns per UTC day.
AI_WS_RATE_LIMIT_GUEST_SOURCE_MAX_TURNS=200
AI_WS_RATE_LIMIT_GUEST_SOURCE_WINDOW_SECONDS=600
AI_GUEST_DAILY_TURN_BUDGET=20000

# [OPTIONAL] Long-term memory recall. Requires ALL of: caller opt-in, this
# flag, and persisted session context.memoryConsent=true. Read only by
# `ai-orchestrator.service.ts` (AiOrchestratorModule, API-only).
AI_MEMORY_RECALL_ENABLED=false

# [OPTIONAL, presence-only] Read solely so the platform AI-monitoring screen
# (`PlatformAiMonitoringModule`, API-only) can report "provider configured:
# yes/no". No code path calls these providers.
#ANTHROPIC_API_KEY=
#AZURE_OPENAI_API_KEY=


# ─────────────────────────────────────────────────────────────────────────
# API-ONLY — EXTERNAL SERVICES / CRM
# ─────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Per-API-key token-bucket ceiling for the read-only external
# integration API (`api-key-auth.guard.ts` — an HTTP guard, meaningless
# without an HTTP server). Redis-unavailable fails OPEN — a courtesy limit,
# not the sole abuse defence.
INTEGRATION_API_RATE_LIMIT_PER_MINUTE=120

# [OPTIONAL] Platform API request logging (`api_logs`), populated by
# `api-logging.interceptor.ts` — an HTTP interceptor, API-only. (The
# RETENTION SWEEP for these logs is shared — see PART 1 § SHARED →
# ANALYTICS / RETENTION → PLATFORM_API_LOG_RETENTION_DAYS.)
#
# ENABLED default true (false under NODE_ENV=test, so load runs measure the
# application rather than the logger). SAMPLE is the logged fraction of ORDINARY
# traffic, 0..1 — default 1 outside production, 0.1 in production.
#
# Two categories ignore SAMPLE and are ALWAYS recorded:
#   - API-key authenticated requests — `api_logs` exists for integration
#     observability and /platform/api-logs/stats meters per-key consumption;
#     sampling those would corrupt the numbers the table exists to report.
#   - Any response >= 400 — error and security visibility is never probabilistic.
#
# Sampling the remainder removes no observability: main.ts records EVERY
# request's method/status/duration into Prometheus from middleware registered
# ahead of the whole guard chain, which is strictly broader coverage than this
# interceptor (it never sees requests the six global guards reject).
#
# Measured cost of the pre-remediation default (sample 1) at 80-100 it/s:
# CPU 97.0% of one core vs 86.6%, p95 4,012ms vs 121ms, ~43,000 extra SQL
# statements. Raise SAMPLE only with that in mind.
#
# CAVEAT: with SAMPLE < 1, /platform/api-logs/stats `totalRequests` for
# cookie/JWT UI traffic is a SAMPLE, not a census. Per-API-key figures stay
# exact (always-record carve-out above).
#PLATFORM_API_LOG_ENABLED=true
#PLATFORM_API_LOG_SAMPLE=0.1

# [OPTIONAL, undocumented in env.validation.ts's Joi schema] Bulk customer
# import limits (`customer-import.constants.ts`, `CrmModule` — imported only
# by AppModule, never by WorkerModule).
#CUSTOMER_IMPORT_MAX_BYTES=
#CUSTOMER_IMPORT_MAX_ROWS=


