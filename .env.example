# ───────────────────────────── Core ─────────────────────────────
NODE_ENV=development
PORT=3000

# Postgres
DATABASE_URL=postgres://user:password@localhost:5432/ziyarati
# Dev only: auto-sync entities to the schema. NEVER true in production.
TYPEORM_SYNCHRONIZE=true
TYPEORM_LOGGING=false
DB_POOL_MAX=10
DB_POOL_MIN=1
DB_POOL_IDLE_TIMEOUT=30000

# Redis / BullMQ (required at runtime for the queue/worker subsystem)
REDIS_URL=redis://localhost:6379
QUEUE_DEFAULT_ATTEMPTS=5
QUEUE_BACKOFF_MS=3000
WORKER_CONCURRENCY=5

# Analytics read cache (Redis). Reuses REDIS_URL on a dedicated connection.
# When REDIS_URL is unset or ANALYTICS_CACHE_ENABLED=false, analytics reads
# fail open to the database. ANALYTICS_CACHE_TTL is in seconds.
ANALYTICS_CACHE_ENABLED=true
ANALYTICS_CACHE_TTL=60
# Raw analytics_events older than this many days are purged daily (retention sweep).
ANALYTICS_EVENT_RETENTION_DAYS=90

# Auth
JWT_ACCESS_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ─────────────────────── Payments / Moyasar (platform) ───────────────────────
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=
MOYASAR_API_BASE=

# ──────────────────── WhatsApp Cloud API / Meta (platform) ────────────────────
# App Secret — used to verify the X-Hub-Signature-256 HMAC on inbound webhooks.
# REQUIRED for webhook ingestion to work (verifier fails closed if unset).
WHATSAPP_APP_SECRET=
# Verify token — the value you enter in the Meta webhook config; echoed back
# during the GET challenge handshake. REQUIRED for webhook verification.
WHATSAPP_VERIFY_TOKEN=
# Shared PLATFORM number credentials (used when a branch has no CUSTOM account).
# Use a System User token in production (long-lived, rotatable).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=

# ───────────────────────── AI / OpenAI + pgvector RAG ─────────────────────────
# With no key: AI uses the Noop provider and RAG falls back to keyword search.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536
RAG_TOP_K=5
HNSW_EF_SEARCH=60
# Requires the Postgres `vector` extension to be available on the server.
AI_PGVECTOR_ENABLED=true
