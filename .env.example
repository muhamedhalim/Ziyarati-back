###############################################################################
# ══ WORKER-ONLY ══  Do NOT set these on the API ECS service — unused there
###############################################################################

# ─────────────────────────────────────────────────────────────────────────
# WORKER-ONLY — DATABASE
# ─────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Per-role pool ceiling for the worker process specifically. Unset
# falls back to the shared DB_POOL_MAX (see PART 1 § SHARED → DATABASE).
# Also referenced (read-only, for its own log line) by the API's
# `cluster-bootstrap.ts` capacity-estimate log — but it only takes effect,
# behaviourally, in this process.
WORKER_DB_POOL_MAX=20
# [OPTIONAL, undocumented in env.validation.ts's Joi schema] Per-role
# statement/idle-in-transaction backstops for the worker specifically. Unset
# falls back to the shared DB_STATEMENT_TIMEOUT/DB_IDLE_IN_TRANSACTION_TIMEOUT.
# The worker's own jobs legitimately run bulk statements (campaign recipient
# expansion, analytics aggregation, retention sweeps) the API never issues,
# hence its higher default.
#WORKER_DB_STATEMENT_TIMEOUT=120000
#WORKER_DB_IDLE_IN_TRANSACTION_TIMEOUT=120000


# ─────────────────────────────────────────────────────────────────────────
# WORKER-ONLY — QUEUES  (BullMQ consumer-side settings + cron/monitor infra)
# ─────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Concurrency per processor. Default 5.
WORKER_CONCURRENCY=5

# [PROD-REQUIRED on this service — do NOT set it on the API]
# all | critical | dispatch. Which processor set THIS worker instance runs.
# The worker process REFUSES TO BOOT in production when this is unset
# (src/worker.module.ts): silently defaulting to `all` would give every
# deployment the unsplit worker — one shared DB pool, one shared connection
# set, every processor and infra cron in one process — with no signal.
#   all       one worker process handles everything. A legitimate choice for a
#             small deployment; logs a warning so the choice is visible.
#   critical  everything EXCEPT campaign dispatch.
#   dispatch  campaign dispatch only.
# Use `critical` + `dispatch` as TWO worker deployments, each with its own
# WORKER_DB_POOL_MAX, once campaign throughput needs its own pool. The API
# deployment must leave this unset entirely — it consumes no queues, and
# `queue.constants.ts`'s `resolveWorkerRole()` is never even called there.
WORKER_ROLE=all

# [OPTIONAL] Campaign dispatch concurrency and global throughput ceiling
# (recipient-send queue only — `dispatchConcurrency()`/`dispatchLimiter()` in
# `queue.constants.ts`, wired into the worker's own BullMQ registration).
#CAMPAIGN_DISPATCH_CONCURRENCY=25
#CAMPAIGN_GLOBAL_MAX_PER_SEC=1000

# [OPTIONAL] Dead-letter-queue and queue-depth monitor knobs
# (`QueueMonitorService`, registered only in `WorkerModule`'s
# `CRITICAL_INFRA`).
#DLQ_POLL_MS=30000
#DLQ_WARN_THRESHOLD=100
#METRICS_QUEUE_DEPTH_POLL_MS=30000
# `true` logs every completed job — very noisy, leave off in production.
#QUEUE_LOG_COMPLETED=false

# [OPTIONAL] Structured logging (LOGGING.md). Placeholders only.
# LOG_LEVEL: debug|info|warn|error|fatal|silent. Default: info when deployed
# (NODE_ENV=production / APP_ENV=production|staging), debug locally.
#LOG_LEVEL=info
# LOG_FORMAT: json|pretty. Deployed environments are ALWAYS json.
#LOG_FORMAT=pretty
# Client address on the access log: full|truncated (/24, /48)|off. Security
# events (failed logins, 401/403/429) always carry the full trusted-proxy IP.
#LOG_ACCESS_CLIENT_IP=truncated
# One app.heartbeat line per process per interval; the "logs silent" alarms
# depend on it. 0 disables.
#LOG_HEARTBEAT_INTERVAL_MS=60000
# Base fields on every line. Defaults: ziyaratech-api / ziyaratech-worker,
# APP_ENV derived from NODE_ENV, version = APP_VERSION or APP_REVISION.
#SERVICE_NAME=ziyaratech-api
#APP_ENV=production
#APP_VERSION=1.0.0
# Commit SHA of the build (7-40 hex). Set by the Docker build (--build-arg).
#APP_REVISION=0000000000000000000000000000000000000000

# [OPTIONAL] OpenTelemetry tracing — OFF unless OTEL_ENABLED=true.
#OTEL_ENABLED=false
# Root sampling ratio 0..1 (default 0.1 deployed, 1 locally).
#OTEL_TRACES_SAMPLER_ARG=0.1
# OTLP/HTTP collector; auth via OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20<token>
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#OTEL_EXPORTER_OTLP_HEADERS=

# [OPTIONAL] Transactional outbox relay, DB to queue (`OutboxRelayService`,
# also registered only in `WorkerModule`'s `CRITICAL_INFRA`).
#OUTBOX_POLL_MS=1000
#OUTBOX_BATCH=100
#OUTBOX_MAX_ATTEMPTS=10
#OUTBOX_RECOVERY_POLL_MS=30000
#OUTBOX_PUBLISHING_STUCK_MS=60000
# The relay (and on-demand exports on the API) hold back once Redis memory
# reaches this % of maxmemory, so rows wait in Postgres (RL-08). Set on both
# the API and the worker.
#QUEUE_ENQUEUE_MAX_REDIS_MEMORY_PERCENT=85


# ─────────────────────────────────────────────────────────────────────────
# WORKER-ONLY — AUTH  (expired-token garbage collection)
# ─────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Expired auth-token cleanup sweep. `AuthTokenMaintenanceService`
# is registered directly by `worker.module.ts` (NOT via AuthModule — see that
# file's own comment) and run by the worker's `PlatformProcessor`. The API
# never instantiates this service at all.
AUTH_TOKEN_RETENTION_DAYS=7
AUTH_TOKEN_CLEANUP_BATCH=1000
AUTH_TOKEN_CLEANUP_MAX_BATCHES=50


# ─────────────────────────────────────────────────────────────────────────
# WORKER-ONLY — AI
# ─────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Cron cadence for the AI batch-status poll sweep. Read only by
# `ScheduleRegistrarService`, registered only in `WorkerModule`'s
# `CRITICAL_INFRA` — the API never registers this (or any) cron.
#AI_BATCH_POLL_CRON=*/5 * * * *


# ─────────────────────────────────────────────────────────────────────────
# WORKER-ONLY — OBSERVABILITY
# ─────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Port for the worker's standalone /metrics listener. The worker
# has no HTTP adapter (it is an application CONTEXT, not an HTTP server — see
# worker.ts's own docstring), so it needs its own plain `http.Server` on its
# own port. The API instead exposes GET /metrics on its normal HTTP port via
# `MetricsController`. Default 9091.
WORKER_METRICS_PORT=9091


