# dotenv environment variable files
# `.env.example` is DELIBERATELY NOT ignored: it is the documented contract of
# every variable this service reads (names, bounds, which are production-
# mandatory) and contains placeholders only — never a real value. Ignoring it
# was the reason production deployments had no authoritative variable list.
.env
.env.development.local
.env.test.local
.env.production.local
.env.local
.env.production

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

docs
ziyaratech.backup

# TestSprite backend tests — one file carries a platform-admin login inline
# (the API issues tokens as HttpOnly cookies, so TestSprite's auto-auth cannot
# fetch them). Keep them out of version control until that credential is moved
# to an injected variable.
/testsprite_tests
# Local production-shaped stack (docker-compose.prod.yml) — throwaway TLS
# material generated by deploy/generate-local-tls.sh. Secures one local
# container, trusted nowhere. Never a production certificate.
/deploy/tls/
