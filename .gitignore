# compiled output
/dist
/node_modules
/build

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files
# `.env.example` is DELIBERATELY NOT ignored: it is the documented contract of
# every variable this service reads (names, bounds, which are production-
# mandatory) and contains placeholders only — never a real value. Ignoring it
# was the reason production deployments had no authoritative variable list.
.env
.env.development.local
.env.test.local
.env.production.local
.env.local
.env.production
.env.strix
# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

docs
# The generated partner guide is a TRACKED artifact: src/config/integration-api-guide.spec.ts
# fails when docs/PARTNER_INTEGRATION_GUIDE.md is missing or out of sync, so CI needs it.
# Everything else under the repo-root docs/ stays ignored; nested docs/ dirs stay ignored.
!/docs/
/docs/*
!/docs/PARTNER_INTEGRATION_GUIDE.md

# The residency / compliance documents are TRACKED: src/modules/data-governance/compliance-docs.spec.ts
# compares the generated tables in the first three with the code registers, so CI needs them,
# and the rest are reviewed with them. Other files in infra/docs/ stay ignored as before.
!infra/docs/
infra/docs/*
!infra/docs/SUBPROCESSORS.md
!infra/docs/DATA-CLASSIFICATION.md
!infra/docs/RETENTION-POLICY.md
!infra/docs/DATA-FLOW.md
!infra/docs/DATA-RESIDENCY.md
!infra/docs/PDPL-COMPLIANCE.md
!infra/docs/TRANSFER-IMPACT-ASSESSMENT.md
!infra/docs/INCIDENT-RESPONSE.md
!infra/docs/AWS-SECURITY.md
!infra/docs/AWS-REGION-STRATEGY.md
!infra/docs/POWER-SWITCH.md
ziyaratech.backup

# TestSprite backend tests — one file carries a platform-admin login inline
# (the API issues tokens as HttpOnly cookies, so TestSprite's auto-auth cannot
# fetch them). Keep them out of version control until that credential is moved
# to an injected variable.
/testsprite_tests
# Local production-shaped stack (docker-compose.prod.yml) — throwaway TLS
# material generated by deploy/generate-local-tls.sh. Secures one local
# container, trusted nowhere. Never a production certificate.
/deploy/tls/

# 20K campaign lab (tests/load/lab): generated lab-only config + secrets, and the generated data packs
# (session tokens, API keys, webhook secrets). Never commit these.
/tests/load/lab/run/
/tests/load/data/generated/
# raw per-run monitor series can be large; the merged results + manifests stay trackable
/tests/load/reports/*.monitor.ndjson
/app.json

# Observability stack: generated scrape token (never commit)
/observability/.secrets/

# LSA-17: perf-run session cookies / tokens are never committed.
scripts/perf/load/*.txt

# Local run markers written by dev scripts
.*-start-time.txt
