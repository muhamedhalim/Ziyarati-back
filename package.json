{
  "name": "ziyarati-back",
  "version": "0.0.1",
  "description": "",
  "author": "Dev:MohammadAbdElhalim",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "start:worker": "node dist/src/worker",
    "migration:run": "node dist/src/migrate.js run",
    "migration:show": "node dist/src/migrate.js show",
    "migration:revert": "node dist/src/migrate.js revert",
    "migration:generate": "node -r dotenv/config ./node_modules/typeorm/cli.js migration:generate -d dist/src/config/data-source.js",
    "retention:run": "node dist/src/retention-run.js",
    "tenant:offboard": "node dist/src/tenant-offboard.js",
    "migration:verify": "ts-node -r tsconfig-paths/register scripts/verify-migrations.ts",
    "start:worker:dev": "ts-node -r tsconfig-paths/register src/worker.ts",
    "dev": "concurrently -n api,worker -c blue,green \"npm:start:dev\" \"npm:start:worker:dev\"",
    "dev:prod-build": "concurrently -n api,worker -c blue,green \"npm:start:prod\" \"npm:start:worker\"",
    "seed": "ts-node --project tsconfig.seed.json src/seed/seed.ts",
    "analytics:rebuild-reports": "ts-node -T -r tsconfig-paths/register scripts/rebuild-analytics-reports.ts",
    "seed:rtl": "ts-node --project tsconfig.seed.json src/seed/rtl-fixture.seed.ts",
    "seed:perf": "ts-node --project tsconfig.seed.json src/seed/perf-fixture.seed.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand --forceExit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "coverage:report": "node scripts/ci/coverage-report.mjs",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "pretest:e2e:integration-platform": "npm run build && node test/setup-e2e-db.js",
    "test:e2e:integration-platform": "jest --config ./test/jest-e2e-integration-platform.json",
    "test:e2e:integration-simulation": "jest --config ./test/jest-e2e.json --runInBand test/integration-external-simulation.e2e-spec.ts test/integration-outbound-simulation.e2e-spec.ts",
    "test:security": "jest --config ./test/jest-security.json",
    "test:ai:live": "jest openai-model-compat",
    "test:ai:benchmark": "jest ai-evaluation.live",
    "test:ai-audit": "jest --config ./test/jest-ai-audit.json --runInBand --testPathIgnorePatterns \"live-\"",
    "test:ai-audit:live": "jest --config ./test/jest-ai-audit.json --runInBand --testPathPattern \"live-\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/client-sesv2": "^3.1075.0",
    "@aws-sdk/client-sqs": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "@nestjs/websockets": "^11.1.27",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/instrumentation-express": "0.70.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/instrumentation-ioredis": "0.70.0",
    "@opentelemetry/instrumentation-pg": "0.74.0",
    "@opentelemetry/instrumentation-undici": "0.32.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/compression": "^1.8.1",
    "bcrypt": "^6.0.0",
    "bidi-js": "^1.0.3",
    "bullmq": "^5.78.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "joi": "^18.2.1",
    "openai": "^6.42.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.20.1",
    "pg": "^8.21.0",
    "pino": "10.3.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.0.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/autocannon": "^7.12.7",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.0.0",
    "@types/uuid": "^10.0.0",
    "artillery": "^2.0.33",
    "autocannon": "^8.0.0",
    "concurrently": "^10.0.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.0.4",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!**/*.d.ts",
      "!migrations/**",
      "!seed/**",
      "!main.ts",
      "!worker.ts",
      "!migrate.ts"
    ],
    "coverageReporters": [
      "text-summary",
      "json-summary",
      "lcov"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
